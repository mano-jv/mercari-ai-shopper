# anthropic, vertex, or openai
# vertex calls Claude on Google Vertex AI. It uses Application Default
# Credentials (gcloud auth application-default login, or
# GOOGLE_APPLICATION_CREDENTIALS), not ANTHROPIC_API_KEY.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=global
# Leave blank to use the latency default (Claude Haiku 5.5 / gpt-4.1).
# Opus or Sonnet only when you set this, e.g. claude-opus-4-6.
LLM_MODEL=
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60

# auto (direct, then browser), dpop, browser, or fixture
MERCARI_SOURCE=auto
# Minimum seconds between live Mercari requests. Jitter is added on top.
MERCARI_MIN_INTERVAL=1.0
MERCARI_CACHE_TTL=300
