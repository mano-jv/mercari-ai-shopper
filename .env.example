# anthropic, vertex, or openai
# vertex calls Claude on Google Vertex AI. It uses Application Default
# Credentials (gcloud auth application-default login, or
# GOOGLE_APPLICATION_CREDENTIALS), not ANTHROPIC_API_KEY.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=global
# Leave blank to use the latency default (Claude Haiku 5.5 / gpt-4.1).
# Opus or Sonnet only when you set this, e.g. claude-opus-4-6.
LLM_MODEL=
# Reasoning/thinking effort: "", low, medium, high, xhigh, or max.
# Claude (anthropic/vertex) sends this as output_config.effort on every
# model that supports it. OpenAI sends it as reasoning_effort, but only on
# reasoning models (o1/o3/o4/gpt-5*) -- it is skipped on gpt-4.1 and other
# non-reasoning models so this setting never breaks the OpenAI default path.
# Lower effort cuts latency, especially on turn 1 (no prompt cache yet).
LLM_EFFORT=low
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=60

# auto (direct, then browser), dpop, browser, or fixture
MERCARI_SOURCE=auto
# Minimum seconds between live Mercari requests. Jitter is added on top.
MERCARI_MIN_INTERVAL=1.0
# How many Mercari requests (e.g. get_item_details fetches) may be in flight
# at once. The min-interval gap still applies on average; this only lets
# that many requests overlap instead of queuing end-to-end.
MERCARI_MAX_CONCURRENT=2
MERCARI_CACHE_TTL=300
